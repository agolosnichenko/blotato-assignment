{
  "name": "blotato-comments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev:api": "tsx watch src/app/api.ts",
    "dev:worker": "tsx watch src/app/worker.ts",
    "build": "tsdown",
    "start:api": "node dist/api.mjs",
    "start:worker": "node dist/worker.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:account": "tsx scripts/seed-account.ts",
    "create-api-key": "tsx scripts/create-api-key.ts",
    "generate-openapi": "tsx scripts/generate-openapi.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@atproto/api": "0.20.42",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "bullmq": "6.3.4",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "uuidv7": "1.2.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "fast-check": "4.9.0",
    "msw": "2.15.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "tsdown": "0.23.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "packageManager": "pnpm@10.26.1"
}
