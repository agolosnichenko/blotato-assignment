# Copy to .env for local development: `docker compose up -d` provides both services.
DATABASE_URL=postgres://comments:comments@localhost:5432/comments
REDIS_URL=redis://localhost:6379

# Optional, shown with their defaults.
# NODE_ENV=development
# HOST=0.0.0.0
# PORT=3000
# LOG_LEVEL=info

# Secrets — no real value is ever committed (D25). Generate your own for local development.
# CREDENTIALS_ENCRYPTION_KEY must be exactly 32 bytes, base64-encoded: `openssl rand -base64 32`.
# CREDENTIALS_ENCRYPTION_KEY=
# CREDENTIALS_KEY_VERSION=1
# META_APP_SECRET=
# META_APP_SECRET_INSTAGRAM=
# META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_API_VERSION=v21.0

# Retention (days). Sync stops polling a post once it falls outside this window (§7.3, §7.4).
# RETENTION_DAYS=45

# Sync intervals (minutes) per age band per platform family — the top band's upper edge is
# RETENTION_DAYS, not a separate variable, so the two cannot drift apart (§7.3).
# SYNC_INTERVALS_BLUESKY_UNDER_24H_MINUTES=5
# SYNC_INTERVALS_BLUESKY_1_TO_7_DAYS_MINUTES=60
# SYNC_INTERVALS_BLUESKY_7_DAYS_TO_RETENTION_MINUTES=1440
# SYNC_INTERVALS_META_UNDER_24H_MINUTES=30
# SYNC_INTERVALS_META_1_TO_7_DAYS_MINUTES=360
# SYNC_INTERVALS_META_7_DAYS_TO_RETENTION_MINUTES=1440

# Manual sync cooldown (seconds, D19).
# SYNC_MANUAL_COOLDOWN_SECONDS=60

# Per-key HTTP rate limit defaults; api_keys.rate_limit_per_min may lower but never raise these.
# RATE_LIMIT_READS_PER_MIN=30
# RATE_LIMIT_WRITES_PER_MIN=5
